{
  "name": "sphynx",
  "version": "0.1.0",
  "description": "Visual, step-by-step explanations of mathematical theorems and definitions",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
